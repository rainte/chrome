{
  "name": "@rainte/chrome",
  "description": "Rainte Chrome CRX",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "npm run ffmpeg && wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "upgrade": "pnpm up -L --registry=https://registry.npmjs.org",
    "lint": "oxlint",
    "ffmpeg": "node scripts/copy-ffmpeg.mjs",
    "copy": "npm run build && powershell -NoProfile -Command \"$dest = Join-Path $env:USERPROFILE 'scoop/persist/chrome/rainte'; if (Test-Path $dest) { Remove-Item -Recurse -Force $dest }; Copy-Item -Recurse crx/rainte $dest\""
  },
  "dependencies": {
    "@ant-design/pro-components": "3.1.15-9",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ffmpeg/core": "^0.12.10",
    "@rainte/ant": "^1.0.4",
    "@wxt-dev/storage": "^1.3.0",
    "antd": "^6.7.0",
    "fast-xml-parser": "^5.12.0",
    "github-markdown-css": "^5.9.0",
    "jszip": "^3.10.2",
    "marked": "^18.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-json-view-lite": "^2.5.0",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@types/m3u8-parser": "^7.2.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "oxlint": "^1.92.0",
    "typescript": "^7.0.2",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  }
}
